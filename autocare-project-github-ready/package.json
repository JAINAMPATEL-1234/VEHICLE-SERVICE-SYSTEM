{
  "name": "autocare-service-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Premium vehicle service management system for cars.",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "prisma db seed",
    "check": "node --check app.js && node --check server.js"
  },
  "prisma": { "seed": "node prisma/seed.js" },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.16",
    "zod": "^3.23.8"
  },
  "devDependencies": { "prisma": "^6.0.0" },
  "engines": { "node": ">=20" }
}
